# Service to retrieve documents from the RAG system

# Input query to retrieve relevant documents
string query
# Number of documents to retrieve (default: 8)
int32 k 8
# Optional metadata filters as JSON string
string filters ''
# Flag to indicate whether to perform refinement on retrieved documents
bool refine_rag false
---
# Response status
string status
# Total number of documents retrieved
int32 total_results
# Array of retrieved documents from ChromaDB
Document[] results
